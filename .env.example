# AuraAssist MCP Server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
MCP_PATH=/mcp
DATABASE_PATH=./aura_assist.db
ENABLE_CAMERA=false
IMAGE_RETENTION_SECONDS=30
REQUIRE_CONFIRMATION=true

# Amazon Bedrock (optional for MVP - mocked if not set)
AWS_REGION=us-east-1
BEDROCK_VISION_MODEL=amazon.nova-lite-v1:0
BEDROCK_REASONING_MODEL=us.amazon.nova-lite-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
